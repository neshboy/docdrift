{
  "name": "docdrift",
  "version": "0.1.0",
  "description": "A CI gate that keeps Markdown documentation honest by checking file-path and symbol references against the actual codebase.",
  "license": "MIT",
  "type": "module",
  "author": "DocDrift contributors",
  "bin": {
    "docdrift": "dist/cli.cjs"
  },
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/cli.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "fast-glob": "^3.3.2",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.4",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.14.9",
    "tsup": "^8.0.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=18"
  }
}
